rules_version = '2';

// Үгийн Тулаан — Firestore аюулгүй байдлын дүрэм.
//  • users/{uid}   : онооны жагсаалт. Тоглогч зөвхөн өөрийнхөө бичлэгийг бичнэ.
//  • matches/{id}  : 1v1 тулаан. Зөвхөн хоёр оролцогч бичнэ.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /users/{uid} {
      allow read: if signedIn();

      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 16
        && request.resource.data.totalScore is int
        && request.resource.data.totalScore >= 0
        && request.resource.data.totalScore <= 100000;

      // Нэг удаагийн бичилтээр оноо хэт их өсөх (хуурах) боломжгүй
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 16
        && request.resource.data.totalScore is int
        && request.resource.data.totalScore >= resource.data.totalScore
        && request.resource.data.totalScore - resource.data.totalScore <= 100000;
    }

    match /matches/{matchId} {
      allow read: if signedIn();

      // Шинэ тулаан: зөвхөн өөрийгөө оролцогчоор нэмж, "waiting" төлөвтэй үүсгэнэ
      allow create: if signedIn()
        && request.resource.data.status == 'waiting'
        && request.resource.data.players.size() == 1
        && request.resource.data.players[0] == request.auth.uid;

      // Оролцогч өөрийн тулааныг шинэчилнэ; хоёр дахь тоглогч "waiting" тулаанд нэгдэнэ
      allow update: if signedIn() && (
        request.auth.uid in resource.data.players
        || (resource.data.status == 'waiting'
            && resource.data.players.size() == 1
            && request.resource.data.players.size() == 2
            && request.auth.uid in request.resource.data.players)
      );

      // Хүлээж буй тулааныг л үүсгэгч нь устгана
      allow delete: if signedIn()
        && resource.data.status == 'waiting'
        && request.auth.uid in resource.data.players;
    }
  }
}
